# ── Macro Predictor — Environment Variables ───────────────────────────────────
# Copy this to .env and fill in your keys

# FRED API key (free) — get at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_key_here

# Telegram Bot Token — create a bot via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Telegram Chat ID — your personal chat ID (message @userinfobot to get it)
TELEGRAM_CHAT_ID=your_chat_id_here

# How many hours before a release to send the pre-release signal alert
ALERT_HOURS_BEFORE=2
