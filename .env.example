# ══════════════════════════════════════════════════════════════════════════════
# MacroPredictor v3 — Environment Variables
# Copy this file to .env and fill in your values.
# ══════════════════════════════════════════════════════════════════════════════

# ── FRED API (required for all USD indicator z-scores) ────────────────────────
# Free account: https://fred.stlouisfed.org/docs/api/api_key.html
# Instant registration, no billing info required.
FRED_API_KEY=dc3c5d3cdb97b2f04a659bcf153cb1c6

# ── Telegram Bot (required for pre/post-release alerts) ───────────────────────
# Create a bot via @BotFather, then get your chat ID via @userinfobot or the
# getUpdates API method.
TELEGRAM_BOT_TOKEN=8818525689:AAEcTYCRuMGw6n6QyhGAH3-lc7s7EF1ekC0
TELEGRAM_CHAT_ID=8483790233

# ── Twelve Data (required for OHLC price data and ATR order-level suggestions) ─
# NEW account required for v3.  Free tier: 800 calls/day, 8 calls/min.
# Register at: https://twelvedata.com/register
# Without this key, order-level suggestions will show null for all pairs.
TWELVE_DATA_API_KEY=your_twelve_data_api_key_here

# ── Alert timing (optional, default 2 hours) ──────────────────────────────────
# How many hours before a release to send the pre-release Telegram alert.
ALERT_HOURS_BEFORE=2

# ── Sources that require NO key (all free, used automatically) ─────────────────
# ECB Statistical Data Warehouse:  https://sdw-wsrest.ecb.europa.eu/service/
# Eurostat dissemination API:      https://ec.europa.eu/eurostat/api/dissemination/
# ONS (UK) API:                    https://api.ons.gov.uk/
# Bank of England database:        https://www.bankofengland.co.uk/boeapps/database/
# OECD SDMX-JSON:                  https://stats.oecd.org/SDMX-JSON/
# GDELT 2.0 DOC API:               https://api.gdeltproject.org/api/v2/doc/doc
# ForexLive RSS:                   https://www.forexlive.com/feed/news/
# FXStreet RSS:                    https://www.fxstreet.com/rss/news
# Central bank speech RSS feeds:   configured in config/events.py RSS_FEEDS
# CFTC COT:                        via cot_reports library (auto-download)
# FinBERT model weights:           ProsusAI/finbert (HuggingFace, ~440 MB,
#                                  downloaded once on first sentiment run)
